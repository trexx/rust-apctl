{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "extends": [
    "docker:enableMajor",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    "default:automergeDigest",
    "default:automergeMinor"
  ],
  "enabledManagers": [
    "cargo",
    "dockerfile",
    "github-actions",
    "npm",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The Rust release CI tests with: the Dockerfile's rust image's, so both move together",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "toolchain: '(?<currentValue>[0-9]+\\.[0-9]+)'"
      ],
      "depNameTemplate": "docker.io/library/rust",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "The cargo-auditable release the Dockerfile installs",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "cargo install --locked (?<depName>cargo-auditable)@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "crate"
    },
    {
      "customType": "regex",
      "description": "Images that workflow steps, scripts and the README's build commands run by hand (docker or podman run), such as the Node image scripts/check.sh --web builds with",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/",
        "/^scripts/[^/]+\\.sh$/",
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "(?<depName>docker\\.io/library/[a-z0-9-]+):(?<currentValue>[A-Za-z0-9._-]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "docker",
      "autoReplaceStringTemplate": "{{depName}}:{{newValue}}{{#if newDigest}}@{{newDigest}}{{/if}}"
    },
    {
      "customType": "regex",
      "description": "The skopeo image the release script inspects and pins images with (tags carry a v)",
      "managerFilePatterns": [
        "/^scripts/release\\.sh$/"
      ],
      "matchStrings": [
        "(?<depName>quay\\.io/skopeo/stable):(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "autoReplaceStringTemplate": "{{depName}}:{{newValue}}{{#if newDigest}}@{{newDigest}}{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "One PR for all non-major Rust crate updates",
      "groupName": "Rust crates",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "description": "One PR for all non-major web UI package updates",
      "groupName": "web UI packages",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "description": "The 3.x driver cannot talk to the MongoDB 3.6 that the official controller ships (informdump import)",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "mongodb"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "The Rust toolchain CI tests with and the Dockerfile's rust image: one release, so one PR",
      "groupName": "Rust toolchain",
      "matchDepNames": [
        "/^(docker\\.io\\/)?(library\\/)?rust$/"
      ]
    },
    {
      "description": "The toolchain version CI tests with has no place for a digest",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "docker.io/library/rust"
      ],
      "pinDigests": false
    },
    {
      "description": "The Node image of the Dockerfile's web stage, of scripts/check.sh --web (CI's web job and the release gate) and of the README: one PR",
      "groupName": "Node image",
      "matchDepNames": [
        "/^(docker\\.io\\/)?(library\\/)?node$/"
      ]
    }
  ]
}
